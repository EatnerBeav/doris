# Secrets never enter git. Keys live only in .env on the server.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc

# Local run state: ledgers, locks and scratch runs (committed traces live in traces/)
/state/
/src/state/
*.sqlite
*.sqlite-journal
*.lock
# What a demo run writes into the sandbox (her sends and her bookings); judges open these after a run
/sandbox/outbox/*
!/sandbox/outbox/.gitkeep
/sandbox/calendar/doris-*.ics
/sandbox/calendar/staged-*.ics
