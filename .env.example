# Every name Doris reads, no values. The real file lives only at /root/doris-secrets/.env on the server.

# Her own Fastmail address: the login for IMAP, SMTP and CalDAV, and the sender of everything she sends.
DORIS_MAIL_ADDRESS=

# An app password for her own account only, with mail and calendar access (one key for IMAP, SMTP, CalDAV).
DORIS_APP_PASSWORD=

# IMAP server; empty means imap.fastmail.com (Fastmail's published server, SSL/TLS).
DORIS_IMAP_HOST=

# IMAP port; empty means 993 (TLS from the first byte).
DORIS_IMAP_PORT=

# SMTP server; empty means smtp.fastmail.com.
DORIS_SMTP_HOST=

# SMTP port; empty means 465 (TLS from the first byte; 587 with STARTTLS is not used).
DORIS_SMTP_PORT=

# The owner's calendar as shared to her account: the full https CalDAV collection URL, no user or password in it.
DORIS_CALDAV_URL=

# The Anthropic API key for the runtime model (never logged or recorded).
ANTHROPIC_API_KEY=

# The runtime model ID; empty means DEFAULT_MODEL in src/doris/model.py.
DORIS_MODEL=

# The one fixed meeting room link every booking carries.
DORIS_MEETING_LINK=
