# Every name Doris reads, and the two only her smoke check reads (WOLF_*), no values. The real file lives only at /root/doris-secrets/.env on the server.

# Her own Fastmail address: the login for IMAP and CalDAV, her JMAP account, and the sender of everything she sends.
DORIS_MAIL_ADDRESS=

# The owner's own address (live only): his mail reaches her addressed to him, and her hold notices go to him.
DORIS_OWNER_ADDRESS=

# An app password for her own account only, with mail and calendar access (one key for IMAP and CalDAV).
DORIS_APP_PASSWORD=

# A Fastmail API token for her own account only (doris.htm), scopes Email and Email submission: every send goes over JMAP.
DORIS_JMAP_TOKEN=

# IMAP server; empty means imap.fastmail.com (Fastmail's published server, SSL/TLS).
DORIS_IMAP_HOST=

# IMAP port; empty means 993 (TLS from the first byte).
DORIS_IMAP_PORT=

# The owner's calendar as shared to her account: the full https CalDAV collection URL, no user or password in it.
DORIS_CALDAV_URL=

# The Anthropic API key for the runtime model (never logged or recorded).
ANTHROPIC_API_KEY=

# The runtime model ID; empty means DEFAULT_MODEL in src/doris/model.py.
DORIS_MODEL=

# The one fixed meeting room link every booking carries.
DORIS_MEETING_LINK=

# The smoke's test account (wolf.whizz), only for its end-to-end test with --send-to: it sends the meeting request; never her loop.
WOLF_EMAIL=

# A Fastmail API token for that test account only (wolf.whizz), scopes Email and Email submission: the smoke alone, never her loop.
WOLF_JMAP_TOKEN=
